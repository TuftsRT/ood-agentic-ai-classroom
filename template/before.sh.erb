#!/usr/bin/env python3
"""
Loopback-only HTTP service that pre-indexes an instructor-provided folder of
reference documents once at session start (before serving any requests),
then answers hybrid TF-IDF + neural-embedding retrieval queries for
guardrails_proxy.py to splice into every chat request. One shared index for
the whole class session, built once -- not per-student, not per-request.

Supports plain text/Markdown/code, Word (.docx), PowerPoint (.pptx), and a
best-effort attempt at PDF -- all with pure-stdlib parsing (zipfile/XML for
the Office formats, zlib + regex content-stream parsing for PDF), since this
environment has none of numpy/scikit-learn/pypdf/python-docx/etc installed
and no internet access to fetch them at runtime. Legacy binary .doc/.ppt are
NOT supported (a different, much harder-to-parse format than modern
zip/XML-based .docx/.pptx) and are skipped like any other unrecognized
extension. The PDF extractor specifically only handles simple, non-scanned,
standard-encoded text -- see extract_pdf_text()'s docstring for exactly what
it can't do. Every extractor is wrapped so a single malformed/unusual file
can only ever remove that one file from the index, never abort indexing for
the rest of the corpus or crash this process.

Usage: rag_index_server.py <listen_port> <docs_dir> <embed_server_port>
"""
import http.server
import json
import math
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
import zipfile
import zlib

LISTEN_PORT = int(sys.argv[1])
DOCS_DIR = sys.argv[2]
EMBED_PORT = int(sys.argv[3])
EMBED_URL = f"http://127.0.0.1:{EMBED_PORT}/v1/embeddings"

# Word counts, not tokens -- no tokenizer is available in this environment
# (see module docstring), and an approximate chunk size is good enough for
# this feature's purpose.
CHUNK_WORDS = 300
OVERLAP_WORDS = 40
TOP_K = 3
# Weighted sum, not reciprocal-rank fusion -- both cosine similarities are
# already bounded roughly to [0, 1], so a weighted sum is simple and legible;
# slightly favors the semantic (embedding) signal over exact lexical overlap.
TFIDF_WEIGHT = 0.4
EMBED_WEIGHT = 0.6
EMBED_BATCH_SIZE = 16
# Fixed name of this app's own shared, student-discoverable session
# directory (see before.sh.erb's Faculty branch / SECURITY-OVERVIEW.md's
# "Faculty/Student roles" section) -- it holds keys.csv (per-student API
# keys) and session.json, created directly under the course storage root
# (a *sibling* of the dedicated subdirectory a known course's
# reference_docs_dir auto-fills to now, course_storage.rb's
# REFERENCE_DOCS_SUBDIR/select_options -- the walk below no longer reaches
# it by default at all). Named explicitly here anyway, as defense in depth
# for the case this skip exists to cover: an instructor who manually pastes
# the course storage root itself into reference_docs_dir, where this skip
# is the only thing stopping keys.csv/session.json from being walked. Not
# left to the generic dot-prefix skip below alone: that skip only prunes
# *subdirectories encountered while walking*, which doesn't cover
# reference_docs_dir being pointed directly at this directory itself, and
# both ".csv"/".json" are on this indexer's own allowed-extensions list, so
# nothing else here would otherwise stop keys.csv from being indexed and
# handed to the model as retrieval context if that skip were ever bypassed
# or changed.
SHARED_SESSION_DIR_NAME = ".llm-classroom-sandbox"
PLAIN_TEXT_EXTENSIONS = {
    "", ".txt", ".md", ".markdown", ".rst", ".csv", ".tsv", ".json",
    ".yaml", ".yml", ".py", ".js", ".ts", ".java", ".c", ".cc", ".cpp",
    ".h", ".hpp", ".sh", ".r", ".tex", ".log", ".ini", ".cfg", ".toml",
}
# Modern, zip/XML-based Office formats only -- NOT legacy binary .doc/.ppt,
# a completely different (OLE Compound File) format this does not parse.
OFFICE_EXTENSIONS = {".docx", ".pptx"}
PDF_EXTENSIONS = {".pdf"}
ALLOWED_EXTENSIONS = PLAIN_TEXT_EXTENSIONS | OFFICE_EXTENSIONS | PDF_EXTENSIONS
MAX_FILE_BYTES = 20_000_000
# PDF content streams containing embedded images/fonts can be large and are
# never useful to this text-only extractor; skipping zlib-decompression of
# anything bigger than this keeps a single image-heavy PDF from dominating
# indexing time. Genuine text content streams are virtually always much
# smaller than this even for a long document.
MAX_PDF_STREAM_BYTES = 2_000_000
# Caps total decompressed/extracted bytes pulled from within any ONE
# instructor-supplied file, regardless of how that total is spread across
# zip members (.docx/.pptx) or PDF content streams. This is a different,
# more important guarantee than MAX_FILE_BYTES above: MAX_FILE_BYTES only
# bounds the file's own on-disk size, but zip and zlib compression both
# allow a tiny file to decompress into gigabytes ("zip/decompression
# bombs") -- a small, otherwise-ordinary-looking .docx or .pdf could
# otherwise exhaust this process's memory during indexing. Generous enough
# that no genuine course document should ever hit it.
MAX_EXTRACTED_BYTES_PER_FILE = 20_000_000
WORD_RE = re.compile(r"[A-Za-z0-9']+")

_chunks = []  # [{"source","text","tfidf","tfidf_norm","embedding","embedding_norm"}]
_idf = {}


class _ByteBudgetExceeded(Exception):
    pass


class _BoundedReader:
    """Wraps a file-like object; raises once more than `budget[0]` bytes
    have been read through it in total (`budget` is a shared, mutable
    single-item list so several readers -- e.g. one per slide in a .pptx --
    can share one running total). This is the actual guard against zip/
    decompression bombs: it counts bytes as they're actually produced,
    never trusting a zip member's own declared/claimed size, which a
    maliciously crafted file can simply lie about."""

    def __init__(self, fileobj, budget):
        self._fileobj = fileobj
        self._budget = budget

    def read(self, size=-1):
        if self._budget[0] <= 0:
            raise _ByteBudgetExceeded("extraction byte budget exhausted")
        request = self._budget[0] if size is None or size < 0 else min(size, self._budget[0])
        chunk = self._fileobj.read(request)
        self._budget[0] -= len(chunk)
        return chunk


def _parse_xml_safely(fileobj):
    # xml.etree.ElementTree is explicitly documented as NOT safe against
    # maliciously constructed XML (billion-laughs entity expansion, and XXE
    # if external entities were allowed) -- there's no defusedxml available
    # here (no internet access to install it at runtime). Legitimate OOXML
    # parts (word/document.xml, ppt/slides/slideN.xml) never contain a
    # DOCTYPE, which is the only way either attack can be expressed in XML,
    # so a raw scan for one before parsing blocks both. Deliberately not
    # reaching into ElementTree's own parser internals to hook this instead
    # (e.g. a custom expat callback) -- CPython uses a C-accelerated
    # XMLParser by default that doesn't expose the same attributes the
    # pure-Python fallback implementation does, so that approach is not
    # portable across Python builds the way this plain byte check is.
    # `fileobj` is already wrapped in _BoundedReader by every caller, so
    # reading it whole here is still bounded by that budget, not unbounded.
    data = fileobj.read()
    if b"<!DOCTYPE" in data:
        raise ValueError("DOCTYPE declarations are not allowed in OOXML parts")
    return ET.fromstring(data)


def log(msg):
    print(f"[rag_index] {msg}", file=sys.stderr, flush=True)


def iter_candidate_files(root):
    # Refuses outright if reference_docs_dir was pointed directly at this
    # app's own shared session directory -- the dirnames-pruning skip below
    # only ever protects it as a *subdirectory* encountered partway through
    # the walk, not as the walk's own root (os.walk never re-checks its
    # starting path the same way). See SHARED_SESSION_DIR_NAME's own comment
    # for why this is named explicitly rather than left to the dot-prefix
    # convention alone.
    if os.path.basename(os.path.normpath(root)) == SHARED_SESSION_DIR_NAME:
        log(f"refusing to index {root}: this is the app's own shared-session directory (API keys), not course material")
        return
    # Skip symlinks (both directories to descend into and individual files):
    # reference_docs_dir is bind-mounted read-only, but a symlink inside it
    # can still point anywhere else this job's own user can read -- silently
    # following one would index and then broadcast that file's content to
    # every student's chat session, well outside the folder the instructor
    # actually chose.
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [
            d for d in dirnames
            if d != SHARED_SESSION_DIR_NAME
            and not d.startswith(".")
            and not os.path.islink(os.path.join(dirpath, d))
        ]
        for name in filenames:
            if name.startswith("."):
                continue
            path = os.path.join(dirpath, name)
            if os.path.islink(path):
                continue
            ext = os.path.splitext(name)[1].lower()
            if ext not in ALLOWED_EXTENSIONS:
                continue
            yield path


def read_plain_text(path):
    with open(path, "rb") as f:
        raw = f.read()
    return raw.decode("utf-8")


_DOCX_NS = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"


def extract_docx_text(path):
    budget = [MAX_EXTRACTED_BYTES_PER_FILE]
    with zipfile.ZipFile(path) as zf:
        with zf.open("word/document.xml") as f:
            root = _parse_xml_safely(_BoundedReader(f, budget))
    paragraphs = []
    for para in root.iter(f"{_DOCX_NS}p"):
        line = "".join(node.text or "" for node in para.iter(f"{_DOCX_NS}t")).strip()
        if line:
            paragraphs.append(line)
    return "\n".join(paragraphs)


_PPTX_NS = "{http://schemas.openxmlformats.org/drawingml/2006/main}"
_PPTX_SLIDE_RE = re.compile(r"ppt/slides/slide(\d+)\.xml$")
# A zip's central directory can declare a huge number of (even empty)
# entries well within MAX_FILE_BYTES -- bounding how many "slides" are ever
# opened caps that cost explicitly, rather than relying only on the
# indirect, much looser bound MAX_FILE_BYTES happens to imply.
MAX_PPTX_SLIDES = 2000


def extract_pptx_text(path):
    # One shared budget across every slide, not one per slide: otherwise a
    # deck with many slides, each individually under the cap, could still
    # add up to an unbounded total (see MAX_EXTRACTED_BYTES_PER_FILE above).
    budget = [MAX_EXTRACTED_BYTES_PER_FILE]
    lines = []
    with zipfile.ZipFile(path) as zf:
        slides = [(m, n) for n in zf.namelist() if (m := _PPTX_SLIDE_RE.search(n))]
        slides.sort(key=lambda pair: int(pair[0].group(1)))
        if len(slides) > MAX_PPTX_SLIDES:
            log(f"{path}: {len(slides)} slide entries found, only processing the first {MAX_PPTX_SLIDES}")
            slides = slides[:MAX_PPTX_SLIDES]
        for _, name in slides:
            try:
                with zf.open(name) as f:
                    root = _parse_xml_safely(_BoundedReader(f, budget))
            except _ByteBudgetExceeded:
                log(f"{path}: hit the per-file extraction budget partway through -- keeping the slides read so far, dropping the rest")
                break
            for node in root.iter(f"{_PPTX_NS}t"):
                if node.text and node.text.strip():
                    lines.append(node.text.strip())
    return "\n".join(lines)


# --- Best-effort, pure-stdlib PDF text extraction. ---
#
# This is NOT a real PDF parser (no object-graph/xref parsing, no font/
# encoding tables, no CID/Type0 support) -- it's a pragmatic regex pass over
# every `stream ... endstream` block, with Flate (zlib) decompression where
# applicable, looking for text-showing operators (`Tj`/`TJ`) and decoding
# their string operands under the assumption of a simple one-byte-per-
# character encoding (WinAnsi/MacRoman-like). That assumption holds for most
# plain text-based PDFs produced by Word/Google Docs/LaTeX with standard
# fonts, which covers most of what an instructor would hand out. It does
# NOT hold for: scanned/image-only PDFs (no text operators exist at all --
# this needs OCR, which is out of scope here), and PDFs using embedded
# subset/CID fonts with custom encodings (the bytes extracted won't map to
# the right characters). _looks_like_text() below is the safety net for
# both: if the result doesn't look like real text, the file is skipped
# entirely rather than indexing garbage.
_PDF_STREAM_RE = re.compile(rb"stream\r?\n(.*?)endstream", re.S)
_PDF_SHOW_TEXT_RE = re.compile(r"\(((?:[^()\\]|\\.)*)\)\s*Tj|\[((?:[^\[\]])*)\]\s*TJ")
_PDF_TJ_STRING_RE = re.compile(r"\(((?:[^()\\]|\\.)*)\)")
_PDF_OCTAL_ESCAPE_RE = re.compile(r"\\([0-7]{1,3})")
_PDF_SIMPLE_ESCAPES = {"n": "\n", "r": "\r", "t": "\t", "b": "\b", "f": "\f", "(": "(", ")": ")", "\\": "\\"}


def _decode_pdf_literal_string(raw):
    out = []
    i, n = 0, len(raw)
    while i < n:
        c = raw[i]
        if c == "\\" and i + 1 < n:
            nxt = raw[i + 1]
            if nxt in _PDF_SIMPLE_ESCAPES:
                out.append(_PDF_SIMPLE_ESCAPES[nxt])
                i += 2
                continue
            if nxt == "\n":
                i += 2  # line-continuation backslash, no output
                continue
            m = _PDF_OCTAL_ESCAPE_RE.match(raw, i)
            if m:
                out.append(chr(int(m.group(1), 8) & 0xFF))
                i = m.end()
                continue
            out.append(nxt)
            i += 2
            continue
        out.append(c)
        i += 1
    return "".join(out)


def _extract_text_from_content_stream(data):
    out = []
    for m in _PDF_SHOW_TEXT_RE.finditer(data):
        if m.group(1) is not None:
            out.append(_decode_pdf_literal_string(m.group(1)))
        elif m.group(2) is not None:
            for s in _PDF_TJ_STRING_RE.finditer(m.group(2)):
                out.append(_decode_pdf_literal_string(s.group(1)))
    return "".join(out)


def _looks_like_text(text):
    stripped = text.strip()
    if len(stripped) < 20:
        return False
    printable = sum(1 for c in stripped if c.isprintable() or c in "\n\r\t")
    return printable / len(stripped) > 0.85


def extract_pdf_text(path):
    with open(path, "rb") as f:
        raw = f.read()
    chunks = []
    total_extracted = 0
    for m in _PDF_STREAM_RE.finditer(raw):
        if total_extracted >= MAX_EXTRACTED_BYTES_PER_FILE:
            log(f"{path}: hit the per-file extraction budget partway through -- keeping the text extracted so far, dropping the rest")
            break
        blob = m.group(1)
        if len(blob) > MAX_PDF_STREAM_BYTES:
            continue  # almost certainly an image/font stream, not text -- not worth decompressing
        try:
            # max_length bounds the DECOMPRESSED output regardless of the
            # compressed size or ratio -- the actual guard against a stream
            # deliberately crafted to inflate far beyond what its compressed
            # size would suggest (a "zlib bomb"), not just a speed shortcut.
            blob = zlib.decompressobj().decompress(blob, MAX_PDF_STREAM_BYTES)
        except zlib.error:
            pass  # not Flate-compressed -- try it as-is; harmless if it's actually an image/font stream
        try:
            text_blob = blob.decode("latin-1")
        except UnicodeDecodeError:
            continue
        chunk = _extract_text_from_content_stream(text_blob)
        if chunk.strip():
            chunks.append(chunk)
            total_extracted += len(chunk)
    text = "\n".join(chunks)
    if not _looks_like_text(text):
        log(f"skipping {path}: extracted PDF text looks empty or garbled (scanned PDF, or a font encoding this lightweight extractor doesn't support)")
        return None
    return text


def extract_text(path):
    # Single entry point for every file this indexer reads. Every extractor
    # above can raise on a malformed/unusual file of its own format (bad
    # zip, malformed XML, unexpected PDF structure, etc.) -- caught broadly
    # here, deliberately, so one bad file only ever drops itself out of the
    # index instead of aborting indexing for the rest of the corpus or
    # crashing this process.
    try:
        if os.path.getsize(path) > MAX_FILE_BYTES:
            log(f"skipping {path}: larger than {MAX_FILE_BYTES} bytes")
            return None
    except OSError as exc:
        log(f"skipping {path}: {exc}")
        return None

    ext = os.path.splitext(path)[1].lower()
    try:
        if ext == ".docx":
            return extract_docx_text(path)
        if ext == ".pptx":
            return extract_pptx_text(path)
        if ext == ".pdf":
            return extract_pdf_text(path)
        return read_plain_text(path)
    except (OSError, UnicodeDecodeError, zipfile.BadZipFile, ET.ParseError, KeyError, ValueError, _ByteBudgetExceeded) as exc:
        log(f"skipping {path}: could not extract text ({type(exc).__name__}: {exc})")
        return None
    except Exception as exc:
        # Last-resort catch-all: an extractor bug on a weird real-world file
        # must never take down indexing for the rest of the session.
        log(f"skipping {path}: unexpected error extracting text ({type(exc).__name__}: {exc})")
        return None


def chunk_text(text):
    words = text.split()
    if not words:
        return []
    step = CHUNK_WORDS - OVERLAP_WORDS
    out = []
    i = 0
    while True:
        out.append(" ".join(words[i:i + CHUNK_WORDS]))
        if i + CHUNK_WORDS >= len(words):
            break
        i += step
    return out


def tokenize(text):
    return [w.lower() for w in WORD_RE.findall(text)]


def embed_batch(texts, prefix):
    # nomic-embed-text requires a task-instruction prefix on every input --
    # "search_document: " when indexing, "search_query: " when querying --
    # or retrieval quality silently degrades (confirmed via the model's own
    # documentation; this is not optional/cosmetic).
    prefixed = [prefix + t for t in texts]
    body = json.dumps({"input": prefixed}).encode("utf-8")
    req = urllib.request.Request(
        EMBED_URL, data=body, headers={"Content-Type": "application/json"}, method="POST"
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        payload = json.load(resp)
    items = sorted(payload["data"], key=lambda d: d["index"])
    return [item["embedding"] for item in items]


def build_index():
    start = time.monotonic()
    raw_chunks = []
    for path in iter_candidate_files(DOCS_DIR):
        text = extract_text(path)
        if not text:
            continue
        rel = os.path.relpath(path, DOCS_DIR)
        for piece in chunk_text(text):
            if piece.strip():
                raw_chunks.append((rel, piece))

    if not raw_chunks:
        log(f"no indexable text files found under {DOCS_DIR}")
        return

    doc_freq = {}
    term_freqs = []
    for _, text in raw_chunks:
        terms = tokenize(text)
        tf = {}
        for t in terms:
            tf[t] = tf.get(t, 0) + 1
        term_freqs.append(tf)
        for t in tf:
            doc_freq[t] = doc_freq.get(t, 0) + 1

    n_docs = len(raw_chunks)
    _idf.update({t: math.log(n_docs / (1 + df)) + 1 for t, df in doc_freq.items()})

    texts = [text for _, text in raw_chunks]
    embeddings = []
    for i in range(0, len(texts), EMBED_BATCH_SIZE):
        batch = texts[i:i + EMBED_BATCH_SIZE]
        try:
            embeddings.extend(embed_batch(batch, "search_document: "))
        except Exception as exc:
            log(f"embedding batch failed ({exc}); those chunks fall back to TF-IDF-only matching")
            embeddings.extend([[] for _ in batch])

    for (source, text), tf, emb in zip(raw_chunks, term_freqs, embeddings):
        tfidf = {t: c * _idf.get(t, 0.0) for t, c in tf.items()}
        tfidf_norm = math.sqrt(sum(w * w for w in tfidf.values())) or 1.0
        emb_norm = math.sqrt(sum(x * x for x in emb)) or 1.0
        _chunks.append({
            "source": source,
            "text": text,
            "tfidf": tfidf,
            "tfidf_norm": tfidf_norm,
            "embedding": emb,
            "embedding_norm": emb_norm,
        })

    log(f"indexed {len(_chunks)} chunks from {len({s for s, _ in raw_chunks})} file(s) under {DOCS_DIR} in {time.monotonic() - start:.1f}s")


def retrieve(query, top_k=TOP_K):
    if not _chunks:
        return []

    tf = {}
    for t in tokenize(query):
        tf[t] = tf.get(t, 0) + 1
    q_tfidf = {t: c * _idf.get(t, 0.0) for t, c in tf.items()}
    q_norm = math.sqrt(sum(w * w for w in q_tfidf.values())) or 1.0

    try:
        q_emb = embed_batch([query], "search_query: ")[0]
    except Exception as exc:
        log(f"query embedding failed ({exc}); falling back to TF-IDF-only scoring")
        q_emb = []
    q_emb_norm = math.sqrt(sum(x * x for x in q_emb)) or 1.0

    scored = []
    for ch in _chunks:
        tfidf_dot = sum(w * ch["tfidf"].get(t, 0.0) for t, w in q_tfidf.items())
        tfidf_cos = tfidf_dot / (q_norm * ch["tfidf_norm"])
        if q_emb and ch["embedding"]:
            emb_dot = sum(a * b for a, b in zip(q_emb, ch["embedding"]))
            emb_cos = emb_dot / (q_emb_norm * ch["embedding_norm"])
        else:
            emb_cos = 0.0
        score = TFIDF_WEIGHT * tfidf_cos + EMBED_WEIGHT * emb_cos
        if score > 0:
            scored.append((score, ch))

    scored.sort(key=lambda pair: pair[0], reverse=True)
    return [
        {"source": ch["source"], "text": ch["text"], "score": round(score, 4)}
        for score, ch in scored[:top_k]
    ]


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    timeout = 10

    def _json(self, status, obj):
        body = json.dumps(obj).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/health":
            self._json(200, {"status": "ok", "chunks": len(_chunks)})
            return
        if parsed.path == "/retrieve":
            qs = urllib.parse.parse_qs(parsed.query)
            query = (qs.get("q") or [""])[0]
            try:
                k = int((qs.get("k") or [str(TOP_K)])[0])
            except ValueError:
                k = TOP_K
            if not query.strip():
                self._json(200, {"results": []})
                return
            try:
                results = retrieve(query, top_k=k)
            except Exception as exc:
                log(f"retrieve failed: {exc}")
                results = []
            self._json(200, {"results": results})
            return
        self._json(404, {"error": "not found"})

    def log_message(self, *_args):
        pass


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    build_index()
    Server(("127.0.0.1", LISTEN_PORT), Handler).serve_forever()
